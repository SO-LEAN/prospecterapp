includes:
    - ../../packages/phpstan-rules/rules.neon

# the core alone has a domain model (ADR 0191, 0193)
rules:
    - Prospecter\PHPStan\DomainMethodsTakeFourParametersAtMostRule

parameters:
    level: max
    ignoreErrors:
        # an array is typed where its values are read, never by a docblock the tool alone asks for (ADR 0022)
        - identifier: missingType.iterableValue
          reportUnmatched: false
    # its result cache in the checkout, kept from one run to the next (the /tmp of the container goes with it)
    tmpDir: var/cache/phpstan
    paths:
        - src/
        - tests/
        # the generator of the event storming and its tests, the one part of packages/phpstan-rules no rule of
        # PHPStan tests; its fixtures are code to analyse, not code of the project
        - ../phpstan-rules/EventStorming/
        - ../phpstan-rules/tests/
    # the fixtures are not analysed, but their classes, which the generator's tests name, are known
    excludePaths:
        analyse:
            - ../phpstan-rules/tests/EventStorming/Fixtures/
    # as many workers as the php container has processors (2, docker-compose.agents.yml), not as the host shows it
    parallel:
        maximumNumberOfProcesses: 2
