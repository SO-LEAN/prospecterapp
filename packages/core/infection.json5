// The tests of mutation of the core (ADR 0091): the unit tests, the scenarios and the event storming generator's tests,
// run by PHPUnit (tests/Mutation)
{
    "$schema": "vendor/infection/infection/resources/schema.json",
    // the event storming's generator is mutated with the core, whose PHPUnit runs its tests (its phpstan-rules suite)
    "source": {"directories": ["src", "../phpstan-rules/EventStorming"]},
    "phpUnit": {"configDir": "tests/Mutation"},
    "mutators": {"@default": true},
    // Infection skips a mutant whose covering tests took longer than this in its first run, under Xdebug: above that
    // whole run, none is skipped, and a mutant's own run, without Xdebug, stops at its first failing test
    "timeout": 600,
    "tmpDir": "var/infection",
    // the summary counts the skipped mutants, and make mutation fails when there is one; the JSON report lists every
    // mutant, which make mutation-summary sums up
    "logs": {"text": "var/mutation.log", "summaryJson": "var/mutation-summary.json", "json": "var/mutation.json"}
}
