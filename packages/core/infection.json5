// The tests of mutation of the core (ADR 0091): the unit tests and the scenarios, run by PHPUnit (tests/Mutation)
{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {"directories": ["src"]},
    "phpUnit": {"configDir": "tests/Mutation"},
    "mutators": {"@default": true},
    // Infection skips a mutant whose covering tests took longer than this in its first run, under Xdebug: above that
    // whole run, none is skipped, and a mutant's own run, without Xdebug, stops at its first failing test
    "timeout": 600,
    "tmpDir": "var/infection",
    // the summary counts the skipped mutants, and make mutation fails when there is one
    "logs": {"text": "var/mutation.log", "summaryJson": "var/mutation-summary.json"}
}
