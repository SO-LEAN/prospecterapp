{
    "name": "prospecter/core",
    "description": "Prospecter business core: entities, use cases and gateway interfaces (clean architecture)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Michel MAIER",
            "email": "opensource@solean-it.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-intl": "*"
    },
    "require-dev": {
        "behat/behat": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "Prospecter\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Core\\": "tests/",
            "Prospecter\\Tools\\PHPStan\\": "../../tools/phpstan/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "behat --colors",
            "phpunit"
        ]
    }
}
