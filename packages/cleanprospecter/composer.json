{
    "name": "so-lean/cleanprospecter",
    "description": "P.O.C. of clean architecture (unclebob)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Michel MAIER",
            "email": "opensource@solean-it.com"
        }
    ],
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "phpspec/prophecy-phpunit": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "Solean\\CleanProspecter\\": "src/CleanProspecter"
        }
    },
    "autoload-dev": {
        "files": ["tests/Unit/Base/functions.php"],
        "psr-4": {
            "Tests\\Unit\\Solean\\": "tests/Unit"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
