# Rules shared by every PHP codebase of the monorepo, included by their phpstan.dist.neon
rules:
    - Prospecter\PHPStan\DependenciesAreInjectedRule
    - Prospecter\PHPStan\TestsReadNoRealClockRule
    - Prospecter\PHPStan\CommandsAndQueriesAreBuiltByNameRule

services:
    -
        class: Prospecter\PHPStan\AggregateStateIsReadByItsRepository
        tags:
            - phpstan.properties.readWriteExtension
