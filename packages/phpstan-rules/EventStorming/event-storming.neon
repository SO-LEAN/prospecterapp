# The analysis that writes a context's event storming (docs/architecture/event-storming.md): no rule of a level, only
# the collectors of its facts, formatted by --error-format=eventStorming. Run from apps/api, whose vendor knows the
# core and the delivery: make event-storming CONTEXT=Booking
parametersSchema:
    eventStorming: structure([
        context: string(),
        features: string(),
        subscriptions: string(),
    ])

parameters:
    customRulesetUsed: true
    tmpDir: %currentWorkingDirectory%/var/cache/phpstan-event-storming
    eventStorming:
        context: %env.EVENT_STORMING_CONTEXT%
        features: %currentWorkingDirectory%/../../packages/core/features
        subscriptions: %currentWorkingDirectory%/config/subscriptions.json

rules:
    - Prospecter\PHPStan\EventStorming\EventStormingFactsRule

services:
    -
        class: Prospecter\PHPStan\EventStorming\ClassFactsCollector
        tags:
            - phpstan.collector
    -
        class: Prospecter\PHPStan\EventStorming\CallsCollector
        tags:
            - phpstan.collector
    -
        class: Prospecter\PHPStan\EventStorming\ConditionalLinesCollector
        tags:
            - phpstan.collector
    -
        class: Prospecter\PHPStan\EventStorming\ModelDocument
        arguments:
            context: %eventStorming.context%
            features: %eventStorming.features%
            subscriptions: %eventStorming.subscriptions%
    errorFormatter.eventStorming:
        class: Prospecter\PHPStan\EventStorming\EventStormingFormatter
