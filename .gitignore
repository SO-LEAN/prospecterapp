/.idea/
/docker/data/*
/.claude/settings.local.json
# Terraform (ADR 0059): the state and the values of an installation never enter this public repository; they are
# kept in INFRA_CONFIG (the *.example files show their shape, docs/architecture/infra.md)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfbackend
*.tfplan
tfplan
override.tf
*_override.tf
.terraformrc
crash.log
BOOTSTRAP.md

# the packages of the apps for AWS (make package-<app>)
/build/
# the downloads the tools keep between their runs (make/aws.mk)
/.cache/
# the port of the host the stack of a worktree is published on (make/stack-port.sh, ADR 0116)
/.stack-port
