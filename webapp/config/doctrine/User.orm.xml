<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Solean\CleanProspecter\Entity\User">
        <field name="roles" type="json" nullable="true"/>
        <field name="password" type="string" length="32" nullable="true"/>
        <field name="userName" type="string" length="50" nullable="true"/>
        <field name="salt" type="string" length="32" nullable="true"/>
        <field name="firstName" type="string" length="100" nullable="true"/>
        <field name="lastName" type="string" length="100" nullable="true"/>
        <field name="hasPicture" type="boolean" nullable="true"/>
        <embedded name="picture" class="Solean\CleanProspecter\Entity\File"/>
        <many-to-one field="organization" target-entity="Solean\CleanProspecter\Entity\Organization" inversed-by="applicationUsers"/>
    </entity>
</doctrine-mapping>
