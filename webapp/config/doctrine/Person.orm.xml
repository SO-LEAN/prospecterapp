<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Solean\CleanProspecter\Entity\Person" table="person" inheritance-type="SINGLE_TABLE">
        <discriminator-column name="discriminator" type="string" length="255"/>
        <discriminator-map>
            <discriminator-mapping value="organization" class="Solean\CleanProspecter\Entity\Organization"/>
            <discriminator-mapping value="prospect" class="Solean\CleanProspecter\Entity\Prospect"/>
            <discriminator-mapping value="user" class="Solean\CleanProspecter\Entity\User"/>
        </discriminator-map>
        <unique-constraints>
            <unique-constraint name="search_idx" columns="email"/>
        </unique-constraints>
        <field name="email" type="string" length="255" nullable="true"/>
        <field name="phoneNumber" type="string" length="255" nullable="true"/>
        <field name="language" type="string" length="255" nullable="true"/>
        <field name="observations" type="string" length="255" nullable="true"/>
    </entity>
</doctrine-mapping>
