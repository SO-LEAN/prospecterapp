# The storage app (apps/storage, ADR 0051): the stored files and their sizes, served from the S3 bucket
# (MiniStack locally, by path); a size missing from the bucket goes to PHP, which makes it once.
server {
    listen 443 ssl;
    http2 on;
    ssl_certificate /etc/ssl/certs/project.crt;
    ssl_certificate_key /etc/ssl/certs/project.key;
    server_name static.${NGINX_HOST};
    root /var/www/src/apps/storage/public;

    fastcgi_hide_header Set-Cookie;
    access_log off;
    add_header Access-Control-Allow-Origin *;

    location /storage/ {
        # resolved on each request: MiniStack may be recreated with another address
        resolver 127.0.0.11 valid=10s;
        set $files ${FILES_HOST};
        rewrite ^/storage/(.*)$ /${FILES_BUCKET}/$1 break;
        proxy_pass http://$files;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Expose-Headers;
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header x-amzn-requestid;
        proxy_intercept_errors on;
        error_page 403 404 = @missing;
    }

    location @missing {
        fastcgi_pass ${PHP_FPM_HOST}:9000;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
    }

    # storing and removing files go through the internal server only
    location / {
        return 404;
    }

    location ~ ^/index\.php(/|$) {
        fastcgi_pass ${PHP_FPM_HOST}:9000;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        internal;
    }

    location ~ \.php$ {
        return 404;
    }
}

# Internal server of the storage app, reached by the services of the platform on the Docker network only
# (http://nginx:8080, not published on the host): they store and remove files with their token.
server {
    listen 8080;
    server_name _;
    root /var/www/src/apps/storage/public;

    location /files {
        try_files $uri /index.php$is_args$args;
    }

    location / {
        return 404;
    }

    location ~ ^/index\.php(/|$) {
        fastcgi_pass ${PHP_FPM_HOST}:9000;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        internal;
    }

    location ~ \.php$ {
        return 404;
    }
}
