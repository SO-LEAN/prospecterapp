# The storage app (apps/storage, ADR 0051): the stored files and their sizes, served from the S3 bucket
# (MiniStack locally, by path); a size missing from the bucket goes to the app in its Lambda (ADR 0055), which
# makes it once.
server {
    listen 443 ssl;
    http2 on;
    ssl_certificate /etc/ssl/certs/project.crt;
    ssl_certificate_key /etc/ssl/certs/project.key;
    server_name static.${NGINX_HOST};

    access_log off;
    add_header Access-Control-Allow-Origin *;
    # resolved on each request: MiniStack may be recreated with another address
    resolver 127.0.0.11 valid=10s;
    set $ministack ${MINISTACK_HOST};

    location /storage/ {
        rewrite ^/storage/(.*)$ /${FILES_BUCKET}/$1 break;
        proxy_pass http://$ministack;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Expose-Headers;
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header x-amzn-requestid;
        proxy_intercept_errors on;
        error_page 403 404 = @missing;
    }

    location @missing {
        include /etc/nginx/storage-lambda.conf;
    }

    # The private files (ADR 0077): only the requests the storage signed, passed as they came for MiniStack to check
    # their signature against this host; MiniStack checks those of the downloads, not those of the upload forms.
    location = /${PRIVATE_FILES_BUCKET} {
        limit_except POST {
            deny all;
        }
        client_max_body_size 11m;
        include /etc/nginx/private-files.conf;
    }

    location /${PRIVATE_FILES_BUCKET}/ {
        limit_except GET {
            deny all;
        }
        if ($args !~ "X-Amz-Signature=") {
            return 403;
        }
        include /etc/nginx/private-files.conf;
    }

    # storing and removing files go through the internal server only
    location / {
        return 404;
    }
}

# Internal server of the storage app, reached by the services of the platform on the Docker network only
# (http://nginx:8080, not published on the host): they store and remove files with their token.
server {
    listen 8080;
    server_name _;
    resolver 127.0.0.11 valid=10s;
    set $ministack ${MINISTACK_HOST};

    location /files {
        include /etc/nginx/storage-lambda.conf;
    }

    # the private files: the forms of the uploads, keeping them, the links reading them, removing them (ADR 0077)
    location ~ ^/(uploads|private-files)(/|$) {
        include /etc/nginx/storage-lambda.conf;
    }

    location / {
        return 404;
    }
}
