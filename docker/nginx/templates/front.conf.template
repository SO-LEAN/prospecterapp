# The SPA: Vite dev server (HMR over the same websocket upgrade)
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    http2 on;
    ssl_certificate /etc/ssl/certs/project.crt;
    ssl_certificate_key /etc/ssl/certs/project.key;
    server_name ${NGINX_HOST};

    # The dev server answers a request per module, about 150 for a page loaded: past 1000 requests (the default),
    # nginx closed the connection of a browser reloading pages, and the modules asked meanwhile failed
    # (net::ERR_FAILED), leaving the page blank
    keepalive_requests 100000;

    location / {
        proxy_pass http://${FRONT_HOST}:5173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 1h;
    }
}
