# The API (apps/api) on PHP-FPM or in its Lambda (API_RUNTIME, ADR 0053), and the Cognito of MiniStack for the SPA
# (ADR 0052): the SPA, served in https, signs in there through this host. MiniStack serves every AWS service on
# one port: only the calls of Cognito pass.
map "$request_method $http_x_amz_target" $cognito_call {
    default 0;
    "~^OPTIONS " 1;
    "~^POST AWSCognitoIdentityProviderService\." 1;
}

server {
    listen 443 ssl;
    http2 on;
    ssl_certificate /etc/ssl/certs/project.crt;
    ssl_certificate_key /etc/ssl/certs/project.key;
    server_name api.${NGINX_HOST};
    root /var/www/src/apps/api/public;
    # resolved on each request: PHP-FPM and MiniStack may be recreated with other addresses
    resolver 127.0.0.11 valid=10s;
    set $ministack ${MINISTACK_HOST};
    set $php_fpm ${PHP_FPM_HOST};

    location /cognito/ {
        if ($cognito_call = 0) {
            return 403;
        }
        rewrite ^/cognito/(.*)$ /$1 break;
        proxy_pass http://$ministack;
    }

    include /etc/nginx/api-runtime/${API_RUNTIME}.conf;
}
