# The API (apps/api) and, on a few paths, the authorization server (apps/auth)
server {
    listen 443 ssl;
    http2 on;
    ssl_certificate /etc/ssl/certs/project.crt;
    ssl_certificate_key /etc/ssl/certs/project.key;
    server_name api.${NGINX_HOST};
    root /var/www/src/apps/api/public;

    # The authorization server (apps/auth) shares the host of the API (ADR 0034): sign-in, OAuth 2 and what a
    # member signs in with go to its front controller, the rest to the API.
    location ~ ^/(authorize|token|login|logout)$ {
        include /etc/nginx/auth_fastcgi.conf;
    }

    location ^~ /auth/ {
        include /etc/nginx/auth_fastcgi.conf;
    }

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location ~ ^/index\.php(/|$) {
        fastcgi_pass ${PHP_FPM_HOST}:9000;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        internal;
    }

    location ~ \.php$ {
        return 404;
    }
}
