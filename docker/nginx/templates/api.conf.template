# The API (apps/api), and the Cognito of MiniStack for the SPA (ADR 0052): the SPA, served in https, signs in
# there through this host. MiniStack serves every AWS service on one port: only the calls of Cognito pass.
map "$request_method $http_x_amz_target" $cognito_call {
    default 0;
    "~^OPTIONS " 1;
    "~^POST AWSCognitoIdentityProviderService\." 1;
}

server {
    listen 443 ssl;
    http2 on;
    ssl_certificate /etc/ssl/certs/project.crt;
    ssl_certificate_key /etc/ssl/certs/project.key;
    server_name api.${NGINX_HOST};
    root /var/www/src/apps/api/public;

    location /cognito/ {
        if ($cognito_call = 0) {
            return 403;
        }
        # resolved on each request: MiniStack may be recreated with another address
        resolver 127.0.0.11 valid=10s;
        set $ministack ${MINISTACK_HOST};
        rewrite ^/cognito/(.*)$ /$1 break;
        proxy_pass http://$ministack;
    }

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location ~ ^/index\.php(/|$) {
        fastcgi_pass ${PHP_FPM_HOST}:9000;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        internal;
    }

    location ~ \.php$ {
        return 404;
    }
}
