# The API (apps/api) in its Lambda behind its HTTP API on MiniStack (ADR 0055), addressed by path: the host of the
# request is kept for the routes of the API, the gateway telling the API it was https. And the Cognito of
# MiniStack for the SPA (ADR 0052): the SPA, served in https, signs in there through this host. MiniStack serves
# every AWS service on one port: only the calls of Cognito pass.
map "$request_method $http_x_amz_target" $cognito_call {
    default 0;
    "~^OPTIONS " 1;
    "~^POST AWSCognitoIdentityProviderService\." 1;
}

server {
    listen 443 ssl;
    http2 on;
    ssl_certificate /etc/ssl/certs/project.crt;
    ssl_certificate_key /etc/ssl/certs/project.key;
    server_name api.${NGINX_HOST};
    # resolved on each request: MiniStack may be recreated with another address
    resolver 127.0.0.11 valid=10s;
    set $ministack ${MINISTACK_HOST};

    location /cognito/ {
        if ($cognito_call = 0) {
            return 403;
        }
        rewrite ^/cognito/(.*)$ /$1 break;
        proxy_pass http://$ministack;
    }

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_read_timeout 60s;
        proxy_pass http://$ministack/_aws/execute-api/prospecter-dev-api/local$request_uri;
    }
}
