<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>{% block header %}Page Title{% endblock %} - SoLean IT</title>
    <link rel="icon" type="image/x-icon" href="{{ asset('images/favicon.ico') }}">
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>
<body class="{{ page|default('') }}" data-page="{{ js_ctrl|default('none') }}" {% for key,value in data_attributes|default({}) %}data-{{ key }}="{{ value }}" {% endfor %}>
    <header class="navbar navbar-expand-md navbar-dark bg-primary navbar-main">
        <a class="navbar-brand d-flex align-items-center" href="{{ path('dashboard_display') }}" title="Dashboard">
            <img src="{{ asset('images/solean.png') }}" height="36" width="36" alt="" class="rounded-circle mr-2">
            Prospecter
        </a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#js-main-menu" aria-controls="js-main-menu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="js-main-menu">
            {%- import "macro/menu.html.twig" as menu -%}
            {{ menu.main() }}
            {% if app.user %}
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item dropdown navbar-user">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="js-user-menu" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            {% if app.user.pictureUrl %}
                                <img src="{{ app.user.pictureUrl|image_operation('resize', 64, 0) }}" height="32" width="32" alt="" class="rounded-circle mr-2">
                            {% else %}
                                <i class="fa fa-user-circle fa-2x mr-2" aria-hidden="true"></i>
                            {% endif %}
                            <span id="func-logged-user">{{ app.user.userIdentifier }}</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="js-user-menu">
                            <a class="dropdown-item" href="{{ path('my_account_information_update') }}"><i class="fa fa-fw fa-user" aria-hidden="true"></i> My account</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="{{ path('logout') }}"><i class="fa fa-fw fa-power-off" aria-hidden="true"></i> Logout</a>
                        </div>
                    </li>
                </ul>
            {% endif %}
        </div>
    </header><!-- /.navbar -->
    {# Flash messages #}
    {% block body %}
    {% endblock %}
    <footer class="bg-dark text-muted">
        <div class="container">
            <div class="row">
                <div class="col-sm-3">
                    <h2>Informations</h2>
                    <ul class="list-unstyled">
                        <li><a href="https://github.com/SO-LEAN" target="_blank"><i class="fa fa-github-square" aria-hidden="true"></i> SOLEAN IT GitHub account</a></li>
                        <li><a href="https://fr.linkedin.com/in/michel-maier-a8b19187" target="_blank"><i class="fa fa-linkedin-square" aria-hidden="true"></i>  My Linkedin page</a></li>
                    </ul>
                </div>
                <div class="col-sm-3 offset-sm-6">
                    <h2>Location</h2>
                    <address>
                        <strong>Solean IT</strong> <br>
                        20 avenue du Neuhof<br>
                        F-67100 Strasbourg <br>

                        France <br><br>
                        <a href="mailto:opensource@solean-it.com" aria-label="email address"><i class="fa fa-envelope-o" aria-hidden="true"></i> opensource@solean-it.com</a><br>
                    </address>
                </div>
            </div>
        </div>
        <hr>
        <div class="container">
            <div class="row">
                <div class="col-sm-7">
                    © So Lean SARL | 2016 - {{ 'now'|date('Y') }}
                </div>
                <div class="col-sm-5">
                    N°SIRET 821 323 557 00016 <br>
                    APE 6202A / Conseil en systèmes et logiciels informatiques
                </div>
            </div>
        </div>
    </footer>
{% block javascripts %}{% endblock %}
</body>
</html>
