{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test-core:*)",
      "Bash(make test-front:*)",
      "Bash(make ci)",
      "Bash(make test)",
      "Bash(make test-api:*)",
      "Bash(make test-storage:*)",
      "Bash(make e2e)",
      "Bash(make lint:*)",
      "Bash(make fix)",
      "Bash(make contract)",
      "Bash(make api-doc)",
      "Bash(make commands)",
      "Bash(make console CMD=\"debug:*)",
      "Bash(make console CMD=\"lint:*)",
      "Bash(make secrets)",
      "Bash(make secrets-branch)",
      "Bash(make ps)",
      "Bash(make logs)"
    ],
    "deny": [
      "Read(./apps/api/.env.local)",
      "Read(./apps/api/.env.*.local)",
      "Read(./apps/api/config/jwt/**)",
      "Read(./apps/front/.env.local)",
      "Read(./docker/data/**)"
    ]
  }
}
