{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make stan)",
      "Bash(make cs)",
      "Bash(make rector)",
      "Bash(make usecases)",
      "Bash(make ps)",
      "Bash(make logs)",
      "Bash(docker compose run --rm php bin/phpunit:*)",
      "Bash(docker compose run --rm php bin/console debug:*)",
      "Bash(docker compose run --rm php bin/console lint:*)",
      "Bash(docker compose run --rm php vendor/bin/phpstan:*)",
      "Bash(docker compose run --rm php vendor/bin/php-cs-fixer fix --dry-run:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ],
    "deny": [
      "Read(./webapp/.env.local)",
      "Read(./webapp/.env.*.local)",
      "Read(./docker/data/**)"
    ]
  }
}
