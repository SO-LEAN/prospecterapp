<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>Connexion · Prospecter</title>
    <link rel="icon" href="/favicon.ico">
    <style>
        /* Same tokens as the SPA design system (apps/front/src/app/styles.css) */
        :root {
            --background: oklch(0.985 0.002 247);
            --surface: oklch(1 0 0);
            --foreground: oklch(0.21 0.02 265);
            --muted: oklch(0.55 0.02 264);
            --border: oklch(0.92 0.005 264);
            --primary: oklch(0.55 0.2 262);
            --primary-hover: oklch(0.5 0.2 262);
            --primary-foreground: oklch(0.99 0 0);
            --ring: oklch(0.55 0.2 262 / 0.35);
            --danger: oklch(0.58 0.21 27);
            --danger-surface: oklch(0.97 0.02 27);
            --radius: 0.75rem;
        }
        @media (prefers-color-scheme: dark) {
            :root {
                --background: oklch(0.16 0.01 265);
                --surface: oklch(0.2 0.012 265);
                --foreground: oklch(0.96 0.005 264);
                --muted: oklch(0.7 0.015 264);
                --border: oklch(0.3 0.015 265);
                --primary: oklch(0.65 0.18 262);
                --primary-hover: oklch(0.7 0.18 262);
                --primary-foreground: oklch(0.16 0.01 265);
                --ring: oklch(0.65 0.18 262 / 0.4);
                --danger: oklch(0.7 0.19 25);
                --danger-surface: oklch(0.25 0.05 25);
            }
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100dvh;
            display: grid;
            place-items: center;
            padding: 1.5rem;
            background:
                radial-gradient(60rem 30rem at 50% -10%, oklch(from var(--primary) l c h / 0.12), transparent 70%),
                var(--background);
            color: var(--foreground);
            font: 400 15px/1.5 "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
            -webkit-font-smoothing: antialiased;
        }
        main { width: 100%; max-width: 24rem; }
        .brand { display: flex; align-items: center; gap: 0.75rem; justify-content: center; margin-bottom: 2rem; font-weight: 600; font-size: 1.125rem; letter-spacing: -0.01em; }
        .brand img { width: 2.25rem; height: 2.25rem; border-radius: 0.6rem; }
        .card { background: var(--surface); border: 1px solid var(--border); border-radius: calc(var(--radius) + 0.25rem); padding: 2rem; box-shadow: 0 1px 2px oklch(0 0 0 / 0.04), 0 12px 32px -12px oklch(0 0 0 / 0.12); }
        h1 { margin: 0 0 0.25rem; font-size: 1.375rem; font-weight: 600; letter-spacing: -0.02em; }
        .subtitle { margin: 0 0 1.75rem; color: var(--muted); }
        label { display: block; margin-bottom: 0.375rem; font-size: 0.875rem; font-weight: 500; }
        .field { margin-bottom: 1.125rem; }
        input[type=text], input[type=password] {
            width: 100%; height: 2.75rem; padding: 0 0.875rem;
            border: 1px solid var(--border); border-radius: var(--radius);
            background: var(--background); color: inherit; font: inherit;
            transition: border-color .15s, box-shadow .15s;
        }
        input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 4px var(--ring); }
        button {
            width: 100%; height: 2.75rem; margin-top: 0.5rem; border: 0; border-radius: var(--radius);
            background: var(--primary); color: var(--primary-foreground); font: inherit; font-weight: 600; cursor: pointer;
            transition: background-color .15s, transform .05s;
        }
        button:hover { background: var(--primary-hover); }
        button:active { transform: translateY(1px); }
        button:focus-visible { outline: none; box-shadow: 0 0 0 4px var(--ring); }
        .error { display: flex; gap: 0.5rem; margin-bottom: 1.25rem; padding: 0.75rem 0.875rem; border-radius: var(--radius); background: var(--danger-surface); color: var(--danger); font-size: 0.875rem; }
        footer { margin-top: 1.5rem; text-align: center; color: var(--muted); font-size: 0.8125rem; }
    </style>
</head>
<body>
<main>
    <div class="brand">
        <img src="/images/logo.png" alt="">
        <span>Prospecter</span>
    </div>
    <div class="card">
        <h1>Connexion</h1>
        <p class="subtitle">Accédez à votre espace de prospection.</p>

        {% if error %}
            <div class="error" id="func-login-error" role="alert">Identifiant ou mot de passe incorrect.</div>
        {% endif %}

        <form method="post" action="{{ path('login') }}" novalidate>
            <div class="field">
                <label for="userName">Identifiant</label>
                <input type="text" id="userName" name="{{ field_name(form.userName) }}" value="{{ field_value(form.userName) }}" autocomplete="username" autofocus required>
            </div>
            <div class="field">
                <label for="password">Mot de passe</label>
                <input type="password" id="password" name="{{ field_name(form.password) }}" autocomplete="current-password" required>
            </div>
            {{ form_widget(form._token) }}
            <button type="submit">Se connecter</button>
        </form>
    </div>
    <footer>© SoLean IT {{ 'now'|date('Y') }}</footer>
</main>
</body>
</html>
