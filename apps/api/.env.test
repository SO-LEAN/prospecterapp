KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
APP_API_HOST=api.test.prospecter.io
# TEST_TOKEN numbers the processes of the tests of mutation (ADR 0091): each recreates its own user pool and tables
COGNITO_USER_POOL_NAME=prospecter-test${TEST_TOKEN:-}
STORAGE_PUBLIC_URL=http://static.test.prospecter.io/storage
STORAGE_INTERNAL_URL=http://storage.test
STORAGE_TOKEN=test-storage-token
APP_GEOCODER_URL=https://geocoder.test/search
DYNAMODB_TABLE_PREFIX=prospecter-test${TEST_TOKEN:-}
INTEGRATION_EVENTS_DELIVERY=sync
INTEGRATION_EVENT_BUS=prospecter-test-integration
INTEGRATION_WORKER=prospecter-test-worker
INTEGRATION_FAILURES_QUEUE=prospecter-test-integration-failures
RELAY_FAILURES_QUEUE=prospecter-test-relay-failures
# the MiniStack of the tests, of this checkout only (docker-compose.yml, make test-api), never that of the stack
DYNAMODB_ENDPOINT=http://ministack-test:4566
COGNITO_ENDPOINT=http://ministack-test:4566
COGNITO_KEYS_URL=http://ministack-test:4566/%s/.well-known/jwks.json
EVENTBRIDGE_ENDPOINT=http://ministack-test:4566
LAMBDA_ENDPOINT=http://ministack-test:4566
SQS_ENDPOINT=http://ministack-test:4566
