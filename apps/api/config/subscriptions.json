  "reporting-figures": {
    "context": "reporting",
    "sources": ["prospecter.prospecting", "prospecter.personal-data"],
    "events": ["OrganizationFactsChanged.v1", "OrganizationFactsChanged.v2", "OrganizationFactsChanged.v3", "ExchangeFactsChanged.v1", "ExchangeFactsChanged.v2", "ExchangeFactsChanged.v3", "ExchangeFactsChanged.v4", "ContactFactsChanged.v1", "ContactFactsChanged.v2"],
