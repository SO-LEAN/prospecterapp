    "context": "connectors",
    "sources": ["prospecter.prospecting"],
    "events": ["ExchangeFactsChanged.v2", "ExchangeFactsChanged.v3", "ExchangeFactsChanged.v4"],
    "payload": {"$or": [{"status": ["planned", "cancelled"]}, {"present": [false]}]},
    "policy": "Prospecter\\Core\\Connectors\\Application\\Policy\\PushExchangePolicy",
    "inbox": true
  },
