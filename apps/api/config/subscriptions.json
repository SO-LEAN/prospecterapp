{
  "accounts-register-the-founder": {
    "context": "accounts",
    "sources": ["prospecter.accounts.internal"],
    "events": ["AccountOpened.v1"],
    "handler": "Prospecter\\Core\\Accounts\\Application\\RegisterTheFounder\\RegisterTheFounderHandler",
    "inbox": true
  },
  "prospecting-stop-keeping-exchanges": {
    "context": "prospecting",
    "sources": ["prospecter.prospecting.internal"],
    "events": ["ProspectingStopped.v1"],
    "handler": "Prospecter\\Core\\Prospecting\\Application\\StopKeepingExchanges\\StopKeepingExchangesHandler",
    "inbox": true
  },
  "prospecting-erase-exchange": {
    "context": "prospecting",
    "sources": ["prospecter.prospecting.internal"],
    "events": ["ExchangeLeftWithoutOrganization.v1"],
    "handler": "Prospecter\\Core\\Prospecting\\Application\\EraseExchangeLeftWithoutOrganization\\EraseExchangeLeftWithoutOrganizationHandler",
    "inbox": true
  },
  "personal-data-collect-founder-profile": {
    "context": "personal-data",
    "sources": ["prospecter.accounts"],
    "events": ["AccountOpened.v1"],
    "handler": "Prospecter\\Core\\PersonalData\\Application\\CollectTheFounderProfile\\CollectTheFounderProfileHandler",
    "inbox": true
  },
  "personal-data-collect-member-profile": {
    "context": "personal-data",
    "sources": ["prospecter.accounts"],
    "events": ["MemberRegistered.v1"],
    "handler": "Prospecter\\Core\\PersonalData\\Application\\CollectTheMemberProfile\\CollectTheMemberProfileHandler",
    "inbox": true
  },
  "personal-data-forget-contacts-left-without-organization": {
    "context": "personal-data",
    "sources": ["prospecter.prospecting"],
    "events": ["ContactsLeftWithoutOrganization.v1"],
    "handler": "Prospecter\\Core\\PersonalData\\Application\\ForgetContactsLeftWithoutOrganization\\ForgetContactsLeftWithoutOrganizationHandler",
    "inbox": true
  },
  "prospecting-attach-collected-contact": {
    "context": "prospecting",
    "sources": ["prospecter.personal-data"],
    "events": ["ContactCollected.v1"],
    "handler": "Prospecter\\Core\\Prospecting\\Application\\AttachCollectedContact\\AttachCollectedContactHandler",
    "inbox": true
  },
  "prospecting-detach-forgotten-contact": {
    "context": "prospecting",
    "sources": ["prospecter.personal-data"],
    "events": ["ContactForgotten.v1"],
    "handler": "Prospecter\\Core\\Prospecting\\Application\\DetachForgottenContact\\DetachForgottenContactHandler",
    "inbox": true
  },
  "prospecting-keep-exchanges-of-forgotten-contact": {
    "context": "prospecting",
    "sources": ["prospecter.personal-data"],
    "events": ["ContactForgotten.v1"],
    "handler": "Prospecter\\Core\\Prospecting\\Application\\KeepExchangesOfForgottenContact\\KeepExchangesOfForgottenContactHandler",
    "inbox": true
  },
  "prospecting-stop-keeping-to-dos": {
    "context": "prospecting",
    "sources": ["prospecter.prospecting.internal"],
    "events": ["ProspectingStopped.v1"],
    "handler": "Prospecter\\Core\\Prospecting\\Application\\StopKeepingToDos\\StopKeepingToDosHandler",
    "inbox": true
  },
  "prospecting-erase-to-do": {
    "context": "prospecting",
    "sources": ["prospecter.prospecting.internal"],
    "events": ["ToDoLeftWithoutOrganization.v1"],
    "handler": "Prospecter\\Core\\Prospecting\\Application\\EraseToDoLeftWithoutOrganization\\EraseToDoLeftWithoutOrganizationHandler",
    "inbox": true
  },
  "prospecting-erase-to-dos-of-forgotten-contact": {
    "context": "prospecting",
    "sources": ["prospecter.personal-data"],
    "events": ["ContactForgotten.v1"],
    "handler": "Prospecter\\Core\\Prospecting\\Application\\EraseToDosOfForgottenContact\\EraseToDosOfForgottenContactHandler",
    "inbox": true
  },
  "prospecting-discard-removed-logo": {
    "context": "prospecting",
    "sources": ["prospecter.prospecting.internal"],
    "events": ["LogoRemoved.v1"],
    "handler": "Prospecter\\Core\\Prospecting\\Application\\DiscardRemovedLogo\\DiscardRemovedLogoHandler",
    "inbox": false
  },
  "prospecting-discard-removed-attachment": {
    "context": "prospecting",
    "sources": ["prospecter.prospecting.internal"],
    "events": ["AttachmentRemoved.v1"],
    "handler": "Prospecter\\Core\\Prospecting\\Application\\DiscardRemovedAttachment\\DiscardRemovedAttachmentHandler",
    "inbox": false
  },
  "prospecting-discard-attachments-of-erased-exchange": {
    "context": "prospecting",
    "sources": ["prospecter.prospecting.internal"],
    "events": ["ExchangeErased.v1"],
    "handler": "Prospecter\\Core\\Prospecting\\Application\\DiscardAttachmentsOfErasedExchange\\DiscardAttachmentsOfErasedExchangeHandler",
    "inbox": false
  },
  "reporting-figures": {
    "context": "reporting",
    "sources": ["prospecter.prospecting", "prospecter.personal-data"],
    "events": ["OrganizationFactsChanged.v1", "ExchangeFactsChanged.v1", "ExchangeFactsChanged.v2", "ContactFactsChanged.v1"],
    "handlers": {
      "OrganizationFactsChanged.v1": "Prospecter\\Core\\Reporting\\Application\\RecordOrganizationFacts\\RecordOrganizationFactsHandler",
      "ExchangeFactsChanged.v1": "Prospecter\\Core\\Reporting\\Application\\RecordExchangeFacts\\RecordExchangeFactsHandler",
      "ExchangeFactsChanged.v2": "Prospecter\\Core\\Reporting\\Application\\RecordExchangeFacts\\RecordExchangeFactsHandler",
      "ContactFactsChanged.v1": "Prospecter\\Core\\Reporting\\Application\\RecordContactFacts\\RecordContactFactsHandler"
    },
    "inbox": false
  }
}
