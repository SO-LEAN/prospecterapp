<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Prospecter\Core\Domain\User\User" table="users">
        <unique-constraints>
            <unique-constraint columns="user_name"/>
        </unique-constraints>
        <indexes>
            <index columns="email"/>
        </indexes>
        <id name="id" type="user_id">
            <generator strategy="NONE"/>
        </id>
        <field name="organizationId" type="organization_id"/>
        <field name="userName" type="string" length="50"/>
        <field name="roles" type="roles"/>
        <embedded name="name" class="Prospecter\Core\Domain\User\PersonName" use-column-prefix="false"/>
        <embedded name="contactDetails" class="Prospecter\Core\Domain\Shared\ContactDetails" use-column-prefix="false"/>
        <field name="picture" type="file" nullable="true"/>
    </entity>
</doctrine-mapping>
