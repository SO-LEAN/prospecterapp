<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Prospecter\Core\Entity\Organization">
        <field name="stats" type="json" nullable="true"/>
        <field name="corporateName" type="string" length="150" nullable="true"/>
        <field name="form" type="string" length="50" nullable="true"/>
        <field name="type" type="string" length="50" nullable="true"/>
        <field name="addressStreet" type="string" length="255" nullable="true"/>
        <field name="addressPostalCode" type="string" length="255" nullable="true"/>
        <field name="addressCity" type="string" length="255" nullable="true"/>
        <field name="addressCountry" type="string" length="255" nullable="true"/>
        <field name="geoPointLongitude" type="float" nullable="true"/>
        <field name="geoPointLatitude" type="float" nullable="true"/>
        <field name="logoUrl" type="string" length="255" nullable="true"/>
        <field name="logoExtension" type="string" length="255" nullable="true"/>
        <field name="logoSize" type="integer" nullable="true"/>
        <many-to-one field="holdBy" target-entity="Prospecter\Core\Entity\Organization"/>
        <many-to-one field="ownedBy" target-entity="Prospecter\Core\Entity\Organization"/>
    </entity>
</doctrine-mapping>
