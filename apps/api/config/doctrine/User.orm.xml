<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Prospecter\Core\Entity\User">
        <field name="roles" type="json" nullable="true"/>
        <field name="userName" type="string" length="50" nullable="true"/>
        <field name="firstName" type="string" length="100" nullable="true"/>
        <field name="lastName" type="string" length="100" nullable="true"/>
        <field name="pictureUrl" type="string" length="255" nullable="true"/>
        <field name="pictureExtension" type="string" length="255" nullable="true"/>
        <field name="pictureSize" type="integer" nullable="true"/>
        <many-to-one field="organization" target-entity="Prospecter\Core\Entity\Organization"/>
    </entity>
</doctrine-mapping>
