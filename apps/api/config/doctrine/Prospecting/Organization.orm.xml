<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Prospecter\Core\Prospecting\Domain\Organization" table="organizations">
        <indexes>
            <index columns="account_id"/>
        </indexes>
        <!-- the safety net of EmailUniqueness, when two requests take the same email at once -->
        <unique-constraints>
            <unique-constraint name="organizations_email_by_account" columns="account_id,email"/>
        </unique-constraints>
        <id name="id" type="organization_id">
            <generator strategy="NONE"/>
        </id>
        <field name="accountId" type="account_id"/>
        <field name="createdBy" type="member_id"/>
        <field name="holdingId" type="organization_id" nullable="true"/>
        <embedded name="legalIdentity" class="Prospecter\Core\SharedKernel\Domain\LegalIdentity" use-column-prefix="false"/>
        <embedded name="contactDetails" class="Prospecter\Core\SharedKernel\Domain\ContactDetails" use-column-prefix="false"/>
        <field name="address" type="address" nullable="true"/>
        <field name="geoPoint" type="geo_point" nullable="true"/>
        <field name="observations" type="string" length="255" nullable="true"/>
        <field name="logo" type="file" nullable="true"/>
        <field name="createdAt" column="created_at" type="moment"/>
        <field name="modifiedAt" column="modified_at" type="moment"/>
    </entity>
</doctrine-mapping>
