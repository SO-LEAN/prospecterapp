<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Prospecter\Core\PersonalData\Domain\Person" table="persons">
        <indexes>
            <index columns="account_id,purpose,email"/>
        </indexes>
        <id name="id" type="person_id">
            <generator strategy="NONE"/>
        </id>
        <field name="accountId" type="account_id"/>
        <field name="purpose" type="string" length="20" enum-type="Prospecter\Core\PersonalData\Domain\Purpose"/>
        <embedded name="name" class="Prospecter\Core\PersonalData\Domain\PersonName" use-column-prefix="false"/>
        <embedded name="contactDetails" class="Prospecter\Core\SharedKernel\Domain\ContactDetails" use-column-prefix="false"/>
        <field name="picture" type="file" nullable="true"/>
        <field name="createdAt" column="created_at" type="moment"/>
        <field name="modifiedAt" column="modified_at" type="moment"/>
    </entity>
</doctrine-mapping>
