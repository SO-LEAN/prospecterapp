# The values of an instance, kept out of the repository as envs/<instance>.tfvars in INFRA_CONFIG
instance       = "dev"
aws_account_id = "123456789012"
region         = "eu-west-3"
# when the account requires every role of an app to carry a permissions boundary
permissions_boundary = "arn:aws:iam::123456789012:policy/my-boundary"
