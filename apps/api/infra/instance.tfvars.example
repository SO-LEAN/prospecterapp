# The values of an instance, kept out of the repository as envs/<instance>.tfvars in INFRA_CONFIG
instance       = "dev"
aws_account_id = "123456789012"
region         = "eu-west-3"
# when the account requires every role of an app to carry a permissions boundary
permissions_boundary = "arn:aws:iam::123456789012:policy/my-boundary"
# outbox when absent; sync runs the reactions within the command, for an instance whose reactions are not in service
# integration_events_delivery = "sync"
# the invocations of the worker running at once, reserved; none when absent: set it once the quota of the account allows
# it (#101), AWS keeping a minimum of the executions of the account unreserved (100 by its documentation), an account
# limited to 10 refusing any reservation
# worker_concurrency = 10
# the requests a second and at once the HTTP API lets through to the public booking pages; 10 and 20 when absent
# public_booking_rate_limit  = 10
# public_booking_burst_limit = 20
# the prefix of the domain of the sign-in page of the AIs, unique in the region; prospecter-<instance>-api when absent
# cognito_domain_prefix = "prospecter-dev-api"
# the requests a second and at once the HTTP API lets through to each route of the facade signing the AIs in and to the
# MCP server; 10 and 20 when absent
# oauth_rate_limit  = 10
# oauth_burst_limit = 20
