# Default values for every environment, committed.
# Override locally in .env.local (not committed), or per environment in .env.$APP_ENV.
# https://symfony.com/doc/current/configuration.html#configuring-environment-variables-in-env-files

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

# the port of the host the stack is published on, in the addresses given to the browser (ADR 0116): none for the stack
# of the main checkout, on 443, :<port> for that of a worktree, given to the function by docker/lambda/deploy.sh
PUBLIC_PORT_SUFFIX=

###> symfony/routing ###
DEFAULT_URI=https://api.local.prospecter.io${PUBLIC_PORT_SUFFIX}
###< symfony/routing ###

# DynamoDB, one table per bounded context named <prefix>-<context> (ADR 0038, 0048), emulated locally by
# MiniStack: dev credentials, AWS gives real ones through the role of the Lambda
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
DYNAMODB_ENDPOINT=http://ministack:4566
DYNAMODB_TABLE_PREFIX=prospecter-dev

APP_API_HOST=api.local.prospecter.io
# the proxies telling the scheme of the request (X-Forwarded-Proto): REMOTE_ADDR in the Lambda, set by its deployment
TRUSTED_PROXIES=
# Cognito (ADR 0052): MiniStack locally, AWS in production; the user pool known by name, its keys read from
# COGNITO_KEYS_URL (%s is the id of the pool), the endpoint the SPA signs in at (empty: the one of AWS; locally
# MiniStack through nginx, the SPA being served in https)
COGNITO_ENDPOINT=http://ministack:4566
COGNITO_USER_POOL_NAME=prospecter-dev
COGNITO_KEYS_URL=http://ministack:4566/%s/.well-known/jwks.json
COGNITO_PUBLIC_ENDPOINT=https://api.local.prospecter.io${PUBLIC_PORT_SUFFIX}/cognito/
# the storage app (apps/storage): the public URL of the files, its internal server for the API (on AWS its function
# URL, the requests signed, ADR 0068), and the token of the services (a dev value, the same as in the storage app;
# read in SSM on AWS)
STORAGE_PUBLIC_URL=https://static.local.prospecter.io${PUBLIC_PORT_SUFFIX}/storage
STORAGE_INTERNAL_URL=http://nginx:8080
STORAGE_TOKEN=dev-storage-token-0f3c9a7e
# the secret the edge of an installation adds to the requests it passes on (ADR 0067): empty, every request is
# answered
ORIGIN_SECRET=
# how the events reach the reactions of config/subscriptions.json: sync, at once, within the command; outbox, written
# with the command, published by the relay on the bus of EventBridge (MiniStack locally, AWS in production), whose
# rules give each to the worker, which runs the reaction of its subscription after the command
INTEGRATION_EVENTS_DELIVERY=outbox
EVENTBRIDGE_ENDPOINT=http://ministack:4566
INTEGRATION_EVENT_BUS=prospecter-dev-integration
# the worker, and the queues of SQS keeping what it could not apply (app:integration:redrive) and what the relay
# could not publish (app:outbox:republish), counted by app:consistency:check
LAMBDA_ENDPOINT=http://ministack:4566
INTEGRATION_WORKER=prospecter-dev-worker
SQS_ENDPOINT=http://ministack:4566
INTEGRATION_FAILURES_QUEUE=prospecter-dev-integration-failures
RELAY_FAILURES_QUEUE=prospecter-dev-relay-failures
# geocoding by the French State (IGN Géoplateforme), no key needed
APP_GEOCODER_URL=https://data.geopf.fr/geocodage/search
# the secrets the accounts give the api, SecureStrings of SSM under this path (ADR 0125): the client of each account
# at Google, its id in the table of Connectors, its secret at <path>/<account>/google-client-secret
SSM_ENDPOINT=http://ministack:4566
ACCOUNT_SECRETS_PATH=/prospecter/dev/api/accounts
# the page of the SPA Google brings the member back to, which the client of each account at Google declares
# (ADR 0120, 0125), and the addresses of Google: locally its double in nginx (docker/nginx/conf.d/google-double.conf),
# its authorization page on the host of the API for the browser, the account of the demonstration served by the
# client of the double; a real client of a project of Google Cloud configured by an administrator of an account, with
# in apps/api/.env.local GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth,
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token and GOOGLE_REVOKE_URL=https://oauth2.googleapis.com/revoke
GOOGLE_REDIRECT_URI=https://local.prospecter.io${PUBLIC_PORT_SUFFIX}/settings/connectors/google
GOOGLE_AUTHORIZATION_URL=https://api.local.prospecter.io${PUBLIC_PORT_SUFFIX}/google/authorize
GOOGLE_TOKEN_URL=http://nginx:8082/token
GOOGLE_REVOKE_URL=http://nginx:8082/revoke

###> nelmio/cors-bundle ###
# the SPA of the stack of the main checkout, or of a worktree on its port (ADR 0116)
CORS_ALLOW_ORIGIN='^https://local\.prospecter\.io(:[0-9]+)?$'
###< nelmio/cors-bundle ###
