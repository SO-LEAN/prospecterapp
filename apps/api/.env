# Default values for every environment, committed.
# Override locally in .env.local (not committed), or per environment in .env.$APP_ENV.
# https://symfony.com/doc/current/configuration.html#configuring-environment-variables-in-env-files

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://api.local.prospecter.io
###< symfony/routing ###

# DynamoDB, one table per bounded context named <prefix>-<context> (ADR 0038, 0048), emulated locally by
# MiniStack: dev credentials, AWS gives real ones through the role of the Lambda
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
DYNAMODB_ENDPOINT=http://ministack:4566
DYNAMODB_TABLE_PREFIX=prospecter-dev

APP_API_HOST=api.local.prospecter.io
# the proxies telling the scheme of the request (X-Forwarded-Proto): REMOTE_ADDR in a Lambda, behind its gateway
TRUSTED_PROXIES=
# Cognito (ADR 0052): MiniStack locally, AWS in production; the user pool known by name, its keys read from
# COGNITO_KEYS_URL (%s is the id of the pool), the endpoint the SPA signs in at (empty: the one of AWS; locally
# MiniStack through nginx, the SPA being served in https)
COGNITO_ENDPOINT=http://ministack:4566
COGNITO_USER_POOL_NAME=prospecter-dev
COGNITO_KEYS_URL=http://ministack:4566/%s/.well-known/jwks.json
COGNITO_PUBLIC_ENDPOINT=https://api.local.prospecter.io/cognito/
# the storage app (apps/storage): the public URL of the files, its internal server for the API, and the
# token of the services of the platform (a dev value, the same as in the storage app; override it in production)
STORAGE_PUBLIC_URL=https://static.local.prospecter.io/storage
STORAGE_INTERNAL_URL=http://nginx:8080
STORAGE_TOKEN=dev-storage-token-0f3c9a7e
# geocoding by the French State (IGN Géoplateforme), no key needed
APP_GEOCODER_URL=https://data.geopf.fr/geocodage/search

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https://local\.prospecter\.io$'
###< nelmio/cors-bundle ###
