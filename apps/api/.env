# Default values for every environment, committed.
# Override locally in .env.local (not committed), or per environment in .env.$APP_ENV.
# https://symfony.com/doc/current/configuration.html#configuring-environment-variables-in-env-files

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://api.local.prospecter.io
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
###< doctrine/doctrine-bundle ###

APP_API_HOST=api.local.prospecter.io
FRONT_URL=https://local.prospecter.io
APP_STATIC_HOST=static.local.prospecter.io
APP_STATIC_PROTOCOL=https
APP_STORAGE_URL=https://static.local.prospecter.io/storage
APP_STORAGE_PATH=%kernel.project_dir%/public/static/storage
# geocoding by the French State (IGN Géoplateforme), no key needed
APP_GEOCODER_URL=https://data.geopf.fr/geocodage/search

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https://local\.prospecter\.io$'
###< nelmio/cors-bundle ###

###> league/oauth2-server-bundle ###
OAUTH_PRIVATE_KEY=%kernel.project_dir%/config/jwt/private.pem
OAUTH_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
OAUTH_PASSPHRASE=09f2091a4b7cdce69ecd92c0c02ea31f
OAUTH_ENCRYPTION_KEY=6c8500dd80d7e0a7a8a8d3eb54a9bab4
###< league/oauth2-server-bundle ###
