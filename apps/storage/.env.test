STORAGE_PUBLIC_URL=http://static.test.prospecter.io/storage
STORAGE_TOKEN=test-storage-token
S3_BUCKET=prospecter-test-files
S3_PRIVATE_BUCKET=prospecter-test-private-files
# the MiniStack of the tests, of this checkout only (docker-compose.yml, make test-storage), never that of the stack;
# the tests send and read as a browser, on the Docker network
S3_ENDPOINT=http://ministack-test:4566
S3_BROWSER_ENDPOINT=http://ministack-test:4566
