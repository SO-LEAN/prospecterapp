{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["event-storming/*.ts", "!event-storming/*.test.ts", "!event-storming/generate.ts"],
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "pool": "vmThreads", "dir": "event-storming" },
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "json"],
  "clearTextReporter": { "allowColor": false, "logTests": false },
  "jsonReporter": { "fileName": "reports/mutation-event-storming.json" },
  "tempDirName": ".stryker-tmp",
  "disableTypeChecks": "event-storming/**/*.ts",
  "tsconfigFile": "no-tsconfig-for-stryker.json",
  "timeoutMS": 30000,
  "dryRunTimeoutMinutes": 15
}
