{
    "openapi": "3.0.0",
    "info": {
        "title": "Prospecter sign-in",
        "description": "Signing in, and what a member signs in with (login email, password), on the authorization server.\n`Authorization: Bearer <access token>` of the SPA on every call but the sign-in; errors are RFC 9457 problem details.\n",
        "version": "1.0.0"
    },
    "paths": {
        "/auth/me/login-email": {
            "patch": {
                "tags": [
                    "Sign-in"
                ],
                "summary": "Change the email I sign in with, unique on the platform",
                "operationId": "patch_auth_me_change_login_email",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginEmailInput"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "What I sign in with",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MeResource"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid access token"
                    },
                    "422": {
                        "description": "Missing or invalid email, or one another member signs in with",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemResource"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/auth/me/password": {
            "patch": {
                "tags": [
                    "Sign-in"
                ],
                "summary": "Change my password",
                "operationId": "patch_auth_me_change_password",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordInput"
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "Password changed"
                    },
                    "401": {
                        "description": "Missing or invalid access token"
                    },
                    "422": {
                        "description": "Password too short",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemResource"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/auth/me": {
            "get": {
                "tags": [
                    "Sign-in"
                ],
                "summary": "The email I sign in with",
                "operationId": "get_auth_me",
                "responses": {
                    "200": {
                        "description": "What I sign in with",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MeResource"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid access token"
                    }
                }
            }
        },
        "/login": {
            "post": {
                "tags": [
                    "Sign-in"
                ],
                "summary": "Sign in with my login email and password, from the SPA only (session cookie of the authorization server)",
                "operationId": "post_sign_in",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SignInInput"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Signed in: open the interrupted authorization request again",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SignInResource"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Wrong login email or password",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemResource"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Not sent by the SPA",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemResource"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many failed attempts: wait a minute",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemResource"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        }
    },
    "components": {
        "schemas": {
            "LoginEmailInput": {
                "properties": {
                    "email": {
                        "type": "string",
                        "default": "",
                        "maxLength": 255
                    }
                },
                "type": "object"
            },
            "PasswordInput": {
                "properties": {
                    "password": {
                        "type": "string",
                        "default": "",
                        "maxLength": 4096,
                        "minLength": 8
                    }
                },
                "type": "object"
            },
            "LinkResource": {
                "required": [
                    "href",
                    "method"
                ],
                "properties": {
                    "href": {
                        "type": "string"
                    },
                    "method": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "MeLinksResource": {
                "required": [
                    "self",
                    "changeMyLoginEmail",
                    "changeMyPassword"
                ],
                "properties": {
                    "self": {
                        "$ref": "#/components/schemas/LinkResource"
                    },
                    "changeMyLoginEmail": {
                        "$ref": "#/components/schemas/LinkResource"
                    },
                    "changeMyPassword": {
                        "$ref": "#/components/schemas/LinkResource"
                    }
                },
                "type": "object"
            },
            "MeResource": {
                "required": [
                    "loginEmail",
                    "_links"
                ],
                "properties": {
                    "loginEmail": {
                        "type": "string"
                    },
                    "_links": {
                        "$ref": "#/components/schemas/MeLinksResource"
                    }
                },
                "type": "object"
            },
            "ViolationResource": {
                "required": [
                    "propertyPath",
                    "title"
                ],
                "properties": {
                    "propertyPath": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "ProblemResource": {
                "required": [
                    "title",
                    "status",
                    "detail"
                ],
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "detail": {
                        "type": "string"
                    },
                    "violations": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ViolationResource"
                        },
                        "default": []
                    },
                    "type": {
                        "type": "string",
                        "default": "about:blank"
                    }
                },
                "type": "object"
            },
            "SignInInput": {
                "properties": {
                    "email": {
                        "type": "string",
                        "default": ""
                    },
                    "password": {
                        "type": "string",
                        "default": ""
                    }
                },
                "type": "object"
            },
            "SignInResource": {
                "required": [
                    "resume"
                ],
                "properties": {
                    "resume": {
                        "description": "The authorization request the sign-in interrupted, to open again; null when the SPA has to start one",
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearer": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "security": [
        {
            "bearer": []
        }
    ],
    "tags": [
        {
            "name": "Sign-in"
        }
    ]
}
