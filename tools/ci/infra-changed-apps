#!/bin/sh
# Prints as JSON the apps whose infrastructure changed in a git range (ADR 0060, 0061): all of them when a file every
# root depends on changed. Usage: tools/ci/infra-changed-apps <range>, such as origin/dev...HEAD
set -eu
changed=$(git diff --name-only "$1")
shared='^(\.terraform-version|Makefile|\.github/workflows/terraform-[a-z]+\.yml|\.github/actions/infra-instance/.*|tools/ci/infra-changed-apps)$'
if echo "$changed" | grep -qE "$shared"; then
    apps=$(printf '%s\n' apps/*/infra | cut -d/ -f2)
else
    apps=$(echo "$changed" | sed -nE 's|^apps/([a-z]+)/infra/.*|\1|p' | sort -u)
fi
echo "$apps" | jq -Rnc '[inputs | select(length > 0)]'
